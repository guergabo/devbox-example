#!/usr/bin/env bash
# Runs as the blueprint's "agent" session (a tmux session) on every devbox.
#
# Waits for the arena to write /workspace/TASK.md, then hands the task to an
# agent in /workspace/app. The agent is read from /workspace/AGENT:
#   claude  Claude Code, interactive, so you can attach and watch or take over.
#   demo    A scripted dark-mode change that needs no API key.
# Without /workspace/AGENT, it uses claude when a key or token is configured
# and demo otherwise.
set -uo pipefail

APP=/workspace/app
TASK_FILE=/workspace/TASK.md
AGENT_FILE=/workspace/AGENT

say() { printf '\033[1;36marena>\033[0m %s\n' "$*"; }

# Prints text a character at a time, so the session looks like an agent typing.
type_out() {
	local text="$1" i
	for ((i = 0; i < ${#text}; i++)); do
		printf '%s' "${text:i:1}"
		sleep 0.02
	done
	printf '\n'
}

run_demo() {
	say "demo agent: no API key needed; it applies a canned dark-mode change"
	say "task was: $(head -n 1 "$TASK_FILE")"
	sleep 1
	for step in \
		"Reading index.html, src/main.js and src/style.css..." \
		"Adding a theme toggle button to index.html..." \
		"Adding body.dark styles to src/style.css..." \
		"Wiring the toggle in src/main.js and remembering the choice in localStorage..."; do
		type_out "$step"
		sleep 1
	done
	if git -C "$APP" apply --whitespace=nowarn - <<'PATCH'
diff --git a/index.html b/index.html
index cf8179b..b282a89 100644
--- a/index.html
+++ b/index.html
@@ -6,6 +6,7 @@
 		<title>To-do</title>
 	</head>
 	<body>
+		<button id="theme-toggle" type="button">Dark mode</button>
 		<h1>To-do</h1>
 		<form id="new-todo">
 			<input placeholder="What needs doing?" autocomplete="off" />
diff --git a/src/main.js b/src/main.js
index 28394f8..41f502b 100644
--- a/src/main.js
+++ b/src/main.js
@@ -31,4 +31,15 @@ form.addEventListener("submit", (event) => {
 	render();
 });
 
+const themeToggle = document.querySelector("#theme-toggle");
+
+function applyTheme(dark) {
+	document.body.classList.toggle("dark", dark);
+	themeToggle.textContent = dark ? "Light mode" : "Dark mode";
+	localStorage.setItem("theme", dark ? "dark" : "light");
+}
+
+themeToggle.addEventListener("click", () => applyTheme(!document.body.classList.contains("dark")));
+applyTheme(localStorage.getItem("theme") === "dark");
+
 render();
diff --git a/src/style.css b/src/style.css
index c9d0bf5..4f0ea6a 100644
--- a/src/style.css
+++ b/src/style.css
@@ -26,3 +26,19 @@ li.done {
 	text-decoration: line-through;
 	opacity: 0.5;
 }
+
+#theme-toggle {
+	float: right;
+}
+
+body.dark {
+	background: #16161d;
+	color: #e8e8ef;
+}
+
+body.dark input,
+body.dark button {
+	background: #26262f;
+	color: inherit;
+	border: 1px solid #3a3a45;
+}
PATCH
	then
		say "change applied; the preview reloads on its own"
		git -C "$APP" --no-pager diff --stat
		type_out "Running the tests..."
		(cd "$APP" && npm test)
	else
		say "the demo change did not apply (was it applied already?)"
	fi
}

run_claude() {
	if [[ -z "${ANTHROPIC_API_KEY:-}" && -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
		say "claude needs ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN in the blueprint environment"
		return
	fi
	# Pre-answer Claude Code's first-run prompts (theme, API key approval,
	# folder trust, bypass-permissions warning) so it starts unattended.
	# Claude Code identifies an approved key by its last 20 characters.
	local key_suffix=""
	[[ -n "${ANTHROPIC_API_KEY:-}" ]] && key_suffix="${ANTHROPIC_API_KEY: -20}"
	mkdir -p "$HOME/.claude"
	cat > "$HOME/.claude.json" <<JSON
{
  "theme": "dark",
  "hasCompletedOnboarding": true,
  "customApiKeyResponses": { "approved": ["$key_suffix"], "rejected": [] },
  "projects": { "$APP": { "hasTrustDialogAccepted": true, "hasCompletedProjectOnboarding": true } }
}
JSON
	echo '{ "skipDangerousModePermissionPrompt": true }' > "$HOME/.claude/settings.json"
	say "starting Claude Code"
	# The devbox is the sandbox: its network policy limits what Claude can reach.
	claude --dangerously-skip-permissions "$(cat "$TASK_FILE")

When you are done, make sure \`npm test\` passes."
}

say "waiting for $TASK_FILE"
until [[ -s "$TASK_FILE" ]]; do sleep 1; done

# Sessions start again on every devbox boot; run the task only once.
if [[ -e /workspace/.arena-started ]]; then
	say "the task already ran on this devbox; resume Claude with: claude --continue"
	cd "$APP" && exec bash -l
fi
touch /workspace/.arena-started

agent=""
[[ -f "$AGENT_FILE" ]] && agent="$(tr -d '[:space:]' < "$AGENT_FILE")"
if [[ -z "$agent" ]]; then
	if [[ -n "${ANTHROPIC_API_KEY:-}" || -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then agent=claude; else agent=demo; fi
fi
say "agent: $agent"

cd "$APP"
case "$agent" in
	claude) run_claude ;;
	demo) run_demo ;;
	# Add more agents here, such as codex.
	*) say "unknown agent '$agent'" ;;
esac

# Keep the session open after the agent exits, so attaching still works.
say "agent finished; this is a shell in $APP"
exec bash -l

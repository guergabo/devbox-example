# Your Amp access token, from https://ampcode.com/settings (starts with sgamp_).
# Every customer's agent uses it in this template; a real platform would use
# each customer's own token.
AMP_API_KEY=

# Partner credentials: let your platform give each customer their own
# Namespace tenant. Today the Namespace team issues them (support@namespace.so);
# this may change once partner access is self-service. Leave them empty to run
# everything in your own workspace (your `devbox login`), without tenants.
NAMESPACE_PARTNER_ID=
NAMESPACE_PARTNER_ISSUER=
NAMESPACE_PARTNER_KEY_ID=
# Path to your partner private key (PEM). Keep the key out of this repository.
NAMESPACE_PARTNER_KEY_FILE=
